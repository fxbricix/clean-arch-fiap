{
  "info": {
    "name": "Cardápio - Clean Architecture",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Fluxo completo: tipos → usuários → restaurante → itens do cardápio. Rode na ordem (Collection Runner)."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "tipoDonoId",
      "value": ""
    },
    {
      "key": "tipoClienteId",
      "value": ""
    },
    {
      "key": "donoId",
      "value": ""
    },
    {
      "key": "clienteId",
      "value": ""
    },
    {
      "key": "restauranteId",
      "value": ""
    },
    {
      "key": "itemId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Tipos de usuário",
      "item": [
        {
          "name": "Listar tipos (resolve ids seedados)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/tipo-usuarios/listar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "tipo-usuarios",
                "listar"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const t = pm.response.json().find(t => t.nome === \"DONO_RESTAURANTE\");",
                  "pm.expect(t, \"tipo DONO_RESTAURANTE seedado\").to.exist;",
                  "pm.collectionVariables.set(\"tipoDonoId\", t.id);",
                  "const t = pm.response.json().find(t => t.nome === \"CLIENTE\");",
                  "pm.expect(t, \"tipo CLIENTE seedado\").to.exist;",
                  "pm.collectionVariables.set(\"tipoClienteId\", t.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Criar tipo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/tipo-usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "tipo-usuarios"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"ENTREGADOR_{{$timestamp}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        }
      ]
    },
